# Autodrome frontend pilot stand defaults.
#
# Copy to `.env` on the stand and adjust values there. Do not commit real
# secrets. The frontend uses relative `/api/<service>/v1` URLs; Next.js
# rewrites proxy those calls to backend services on the same stand.

COMPOSE_PROJECT_NAME=autodrome-frontend-pilot
PILOT_FRONTEND_HOME=/home/cv/autodrome-pilot-frontend
FRONTEND_ROOT=/home/cv/autodrome-pilot-frontend/source

FRONTEND_PUBLIC_PORT=13000
AUTODROME_PILOT_BACKEND_HOST=http://127.0.0.1

NEXT_PUBLIC_API_ADAPTER=live
NEXT_PUBLIC_MOCK_SCENARIO=normal

