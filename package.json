{
  "name": "autodrome-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc",
    "test": "vitest run",
    "contracts:check": "node scripts/check-contracts.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "release-gate": "pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e:install": "playwright install chromium",
    "e2e:build": "NEXT_PUBLIC_API_ADAPTER=mock NEXT_PUBLIC_MOCK_SCENARIO=normal next build",
    "e2e": "pnpm e2e:build && playwright test"
  },
  "dependencies": {
    "next": "16.2.9",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "happy-dom": "^20.10.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
